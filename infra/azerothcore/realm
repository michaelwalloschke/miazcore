#!/usr/bin/env bash
set -euo pipefail

base_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
compose=(docker compose --project-directory "$base_dir" --file "$base_dir/compose.yaml")

if [[ -f "$base_dir/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$base_dir/.env"
    set +a
fi
[[ -z "${MIAZCORE_COMPOSE_PROJECT+x}" && -z "${MIAZCORE_REALM_ADDRESS+x}" ]] || {
    echo "canonical Reference Realm does not accept project or endpoint overrides" >&2
    exit 64
}
project="miazcore-reference-realm"
compose+=(--project-name "$project")
lock_dir="$(cd -- "$base_dir/../.." && pwd)/.scratch/learning-client/.realm-test.lock"
lock_owned=false

acquire_reset_lock() {
    [[ "${MIAZCORE_REALM_LOCK_HELD:-0}" == 1 ]] && return
    if ! mkdir "$lock_dir" 2>/dev/null; then
        echo "Reference Realm reset is already owned by another process" >&2
        exit 75
    fi
    printf 'script=infra/azerothcore/realm\npid=%s\nstarted_utc=%s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$lock_dir/owner"
    lock_owned=true
}

release_reset_lock() {
    [[ "$lock_owned" == true ]] || return
    rm -f "$lock_dir/owner"
    rmdir "$lock_dir"
}

usage() {
    echo "usage: $0 {init-secrets|preflight|up|down|health|wait-character-offline|smoke|reset-state|reset-all|stop-worldserver|start-worldserver} [--yes]" >&2
    exit 64
}

require_secrets() {
    local name path mode owner
    for name in database-password database-root-password fixture-account fixture-password fixture-pair-a-account fixture-pair-a-password fixture-pair-b-account fixture-pair-b-password; do
        path="$base_dir/secrets/$name"
        [[ -s "$path" && -f "$path" && ! -L "$path" ]] || {
            echo "missing or unsafe secret file: $path; run '$0 init-secrets'" >&2
            exit 64
        }
        mode="$(stat -f '%OLp' "$path" 2>/dev/null || stat -c '%a' "$path")"
        owner="$(stat -f '%u' "$path" 2>/dev/null || stat -c '%u' "$path")"
        [[ "$mode" == 600 && "$owner" == "$UID" ]] || {
            echo "secret file must be current-user owned mode 0600: $path" >&2
            exit 64
        }
    done
}

validate_pair_pdumps() {
    local fixture checksum
    for fixture in reference-pair-a-character.pdump reference-pair-b-character.pdump; do
        checksum="$base_dir/fixtures/$fixture.sha256"
        [[ -f "$base_dir/fixtures/$fixture" && -f "$checksum" ]] || {
            echo "missing reviewed Pair Pdump/provenance checksum: $fixture" >&2
            exit 66
        }
        (cd "$base_dir/fixtures" && sha256sum --check --status "$(basename -- "$checksum")") || {
            echo "Pair Pdump provenance checksum failed: $fixture" >&2
            exit 66
        }
    done
}

init_secrets() {
    umask 077
    mkdir -p "$base_dir/secrets"
    [[ -e "$base_dir/secrets/database-password" ]] || openssl rand -hex 24 >"$base_dir/secrets/database-password"
    [[ -e "$base_dir/secrets/database-root-password" ]] || openssl rand -hex 24 >"$base_dir/secrets/database-root-password"
    [[ -e "$base_dir/secrets/fixture-account" ]] || printf 'MIAZTEST\n' >"$base_dir/secrets/fixture-account"
    [[ -e "$base_dir/secrets/fixture-password" ]] || openssl rand -hex 8 >"$base_dir/secrets/fixture-password"
    [[ -e "$base_dir/secrets/fixture-pair-a-account" ]] || printf 'MIAZPAIRA\n' >"$base_dir/secrets/fixture-pair-a-account"
    [[ -e "$base_dir/secrets/fixture-pair-a-password" ]] || openssl rand -hex 8 >"$base_dir/secrets/fixture-pair-a-password"
    [[ -e "$base_dir/secrets/fixture-pair-b-account" ]] || printf 'MIAZPAIRB\n' >"$base_dir/secrets/fixture-pair-b-account"
    [[ -e "$base_dir/secrets/fixture-pair-b-password" ]] || openssl rand -hex 8 >"$base_dir/secrets/fixture-pair-b-password"
    chmod 600 "$base_dir"/secrets/{database-password,database-root-password,fixture-account,fixture-password,fixture-pair-a-account,fixture-pair-a-password,fixture-pair-b-account,fixture-pair-b-password}
    echo "created or retained eight ignored secret files"
}

assert_labeled_volume() {
    local volume="$1" expected_kind="$2" actual_label actual_kind
    actual_label="$(docker volume inspect --format '{{ index .Labels "com.miazcore.reference-realm" }}' "$volume")"
    actual_kind="$(docker volume inspect --format '{{ index .Labels "com.miazcore.reference-realm.kind" }}' "$volume")"
    [[ "$actual_label" == true && "$actual_kind" == "$expected_kind" ]] || {
        echo "refusing to remove unlabeled or mismatched volume: $volume" >&2
        exit 65
    }
}

reset() {
    local include_data="$1" confirmed="${2:-}"
    local state_volume="${project}_database-data" data_volume="${project}_server-data"
    validate_pair_pdumps
    echo "reset target: $state_volume"
    [[ "$include_data" == true ]] && echo "reset target: $data_volume"
    if [[ "$confirmed" != --yes ]]; then
        read -r -p "Remove only the listed labeled volumes? [y/N] " answer
        [[ "$answer" == y || "$answer" == Y ]] || { echo "reset cancelled"; exit 0; }
    fi
    "${compose[@]}" down --remove-orphans
    if docker volume inspect "$state_volume" >/dev/null 2>&1; then
        assert_labeled_volume "$state_volume" state
        docker volume rm "$state_volume"
    fi
    if [[ "$include_data" == true ]] && docker volume inspect "$data_volume" >/dev/null 2>&1; then
        assert_labeled_volume "$data_volume" server-data
        docker volume rm "$data_volume"
    fi
    "$0" up
    if [[ -n "${MIAZCORE_RESET_COMPLETION_FILE:-}" ]]; then
        umask 077
        printf 'reset-complete\n' >"$MIAZCORE_RESET_COMPLETION_FILE"
    fi
}

preflight() {
    require_secrets
    validate_pair_pdumps
}

case "${1:-}" in
    init-secrets) init_secrets ;;
    preflight) preflight ;;
    up)
        preflight
        "${compose[@]}" config --quiet
        if [[ "${MIAZCORE_SKIP_PULL:-0}" != 1 ]]; then
            "${compose[@]}" pull
        fi
        # The import and fixture provisioner are expected one-shot services.
        # Recent Compose versions can return non-zero from `--wait` when those
        # services have already exited successfully.  The canonical health
        # boundary below decides whether the realm is actually usable, so keep
        # that harmless Compose result from turning a completed reset into a
        # false failure while still failing closed on an unhealthy realm.
        compose_wait_status=0
        "${compose[@]}" up --detach --wait --wait-timeout 900 || compose_wait_status=$?
        if [[ "$compose_wait_status" != 0 ]]; then
            echo "compose wait returned $compose_wait_status; verifying canonical realm health after server recreation" >&2
        fi
        # One-shot import/provision work may recreate or restart MySQL while an
        # existing server container remains up. Always finish with fresh server
        # processes so their pools and realm cache target the current database.
        "${compose[@]}" up --detach --force-recreate --no-deps authserver worldserver
        "${compose[@]}" up --detach --wait --wait-timeout 180 --no-deps authserver worldserver
        "$0" health
        ;;
    down) "${compose[@]}" down --remove-orphans ;;
    # Test-only, local proof fault injection. These commands deliberately
    # affect only the World endpoint; auth and the database remain running so
    # a reconnect failure cannot be mistaken for a credentials failure.
    stop-worldserver) "${compose[@]}" stop worldserver ;;
    start-worldserver)
        require_secrets
        "${compose[@]}" up --detach --wait --wait-timeout 180 worldserver
        "$0" health
        ;;
    health)
        require_secrets
        "${compose[@]}" ps --all
        for port in 3724 8085; do
            timeout_seconds=5
            python3 - "$port" "$timeout_seconds" <<'PY'
import socket, sys
port, timeout = int(sys.argv[1]), float(sys.argv[2])
with socket.create_connection(("127.0.0.1", port), timeout):
    print(f"host socket: 127.0.0.1:{port} reachable")
PY
        done
        "${compose[@]}" exec -T --env "MIAZCORE_EXPECTED_REALM_ADDRESS=127.0.0.1" database bash -ceu '
          export MYSQL_PWD="$(cat /run/secrets/database_root_password)"
          mysql_base=(mysql --user=root --batch --skip-column-names)
          realm_count="$("${mysql_base[@]}" acore_auth --execute="
            SELECT COUNT(*) FROM realmlist
            WHERE id=1 AND name=\"Miazcore Reference Realm\" AND address=\"$MIAZCORE_EXPECTED_REALM_ADDRESS\"
              AND port=8085 AND gamebuild=12340;")"
          fixture_count="$("${mysql_base[@]}" acore_characters --execute="
            SELECT COUNT(*) FROM characters c JOIN acore_auth.account a ON a.id=c.account
            WHERE (a.username, c.name) IN ((\"MIAZTEST\", \"Miaztest\"), (\"MIAZPAIRA\", \"Miazpaira\"), (\"MIAZPAIRB\", \"Miazpairb\"))
              AND a.expansion=2 AND a.locked=0 AND a.lock_country=\"00\" AND (a.totp_secret IS NULL OR a.totp_secret=\"\")
              AND c.race=1 AND c.class=1 AND c.gender=0 AND c.level=1 AND c.map=0 AND c.online=0 AND c.transguid=0
              AND c.trans_x=0 AND c.trans_y=0 AND c.trans_z=0 AND c.trans_o=0;")"
          distinct_accounts="$("${mysql_base[@]}" acore_characters --execute="
            SELECT COUNT(DISTINCT c.account) FROM characters c
            WHERE c.name IN (\"Miaztest\", \"Miazpaira\", \"Miazpairb\");")"
          relation="$("${mysql_base[@]}" acore_characters --execute="
            SELECT COUNT(*) FROM characters a JOIN characters b
            WHERE a.name=\"Miazpaira\" AND b.name=\"Miazpairb\" AND a.map=b.map
              AND ABS((b.position_x-a.position_x)-3.0)<=0.001 AND ABS(b.position_y-a.position_y)<=0.001
              AND ABS(b.position_z-a.position_z)<=0.001 AND ABS(b.orientation-a.orientation)<=0.001;")"
          [[ "$realm_count" == 1 && "$fixture_count" == 3 && "$distinct_accounts" == 3 && "$relation" == 1 ]]
        '
        echo "health: orchestration, processes, host sockets, and three-fixture invariant passed"
        ;;
    # Test-only settlement boundary. A successful client logout closes its
    # socket before AzerothCore has necessarily persisted `online=0`; callers
    # must wait for that single state transition before one final health gate.
    wait-character-offline)
        require_secrets
        # The client can exit only after its fresh-reconnect proof; the realm's
        # asynchronous logout persistence has observed up to ~46 seconds after
        # that hand-off. Leave margin while remaining a bounded test wait.
        deadline_seconds="${MIAZCORE_LOGOUT_SETTLEMENT_TIMEOUT_SECONDS:-60}"
        [[ "$deadline_seconds" =~ ^[1-9][0-9]*$ ]] || {
            echo "logout settlement timeout must be a positive whole number" >&2
            exit 64
        }
        for ((elapsed = 0; elapsed < deadline_seconds; elapsed++)); do
            if "${compose[@]}" exec -T database bash -ceu '
              export MYSQL_PWD="$(cat /run/secrets/database_root_password)"
              mysql --user=root --batch --skip-column-names acore_characters --execute="
                SELECT COUNT(*) FROM characters
                WHERE name IN (\"Miaztest\", \"Miazpaira\", \"Miazpairb\") AND online=0 AND transguid=0;" | grep -qx 3
            '; then
                echo "logout settlement: reference character is offline"
                exit 0
            fi
            sleep 1
        done
        echo "timed out waiting ${deadline_seconds}s for reference character logout settlement" >&2
        exit 1
        ;;
    smoke)
        require_secrets
        "$base_dir/tools/bootstrap_character.py"
        ;;
    reset-state)
        acquire_reset_lock
        trap release_reset_lock EXIT INT TERM
        reset false "${2:-}"
        ;;
    reset-all)
        acquire_reset_lock
        trap release_reset_lock EXIT INT TERM
        reset true "${2:-}"
        ;;
    *) usage ;;
esac
